{
  "name": "qvapay",
  "version": "0.0.0",
  "description": "CLI para la wallet personal de QvaPay: TUI interactiva y comandos directos.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "qvapay": "src/cli.ts"
  },
  "files": [
    "src",
    "agent"
  ],
  "scripts": {
    "dev": "bun --watch run src/cli.ts",
    "dev:tui": "bun --watch run src/tui/dev.tsx",
    "start": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "commander": "^12.1.0",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
